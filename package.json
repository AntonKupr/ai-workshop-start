{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal or in a web page.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.ts && playwright test",
